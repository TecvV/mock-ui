{
  "name": "cat-mock-ui",
  "version": "1.0.0",
  "description": "Desktop mock test application for CAT and sectional practice papers.",
  "author": "Ayan Mishra",
  "private": true,
  "main": "electron-main.js",
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-scripts": "5.0.1"
  },
  "devDependencies": {
    "electron": "^37.0.0",
    "electron-builder": "^26.0.12"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "serve": "node server.js",
    "build-and-serve": "react-scripts build && node server.js",
    "desktop": "electron .",
    "dist:win": "npm run build && electron-builder --win portable",
    "test": "react-scripts test",
    "eject": "react-scripts eject"
  },
  "build": {
    "extends": null,
    "appId": "com.ayanmishra.catmockui",
    "productName": "CAT Mock UI",
    "artifactName": "CAT Mock UI ${version}.${ext}",
    "directories": {
      "output": "release"
    },
    "icon": "assets/icon.png",
    "files": [
      "build/**/*",
      "electron-main.js",
      "server.js",
      "package.json"
    ],
    "win": {
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    }
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}

